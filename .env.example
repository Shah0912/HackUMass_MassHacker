# Copy to .env.local and fill in. .env.local is gitignored.
# Keys are server-only: read by api/ functions. Never prefix them with VITE_ (that ships them to the browser).

# Which model provider to use: gemini | claude | grok.
# If empty, uses whichever key is set (Gemini, then Claude, then Grok).
AI_PROVIDER=

GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# xAI key for Grok, from console.x.ai.
XAI_API_KEY=

# Optional model overrides (defaults: gemini-2.5-flash, claude-opus-5-5, grok-4.3).
GEMINI_MODEL=
CLAUDE_MODEL=
GROK_MODEL=

# Server: return fixtures from the real endpoints instead of calling a model.
MOCK_AI=0
# Client: 1 = skip the network entirely and return fixtures (no key needed). 0 = call /api (default).
VITE_MOCK_AI=0
